

// ------------------------------------------------
//    Cell Geometry
// ------------------------------------------------
forall delete_section()

proc celldef() {
  subsets()
  geom()
  biophys()
  geom_nseg()
}

apicNum		=	1
bigDendNum	=	1
dendNum		=	6
apicalBranchNum	=	1
basalalBranchNum =	2                //////////
myNum		=	10
nodeNum		=	10

create soma, bigDend, dend[dendNum], apic[apicNum],  branch[apicalBranchNum] , basalBranch[basalalBranchNum]//, my[myNum], node[nodeNum]

soma { L=30   diam=30 }
apic { L=800   diam=6    nseg=10 }
//apic { L=830   diam=6    nseg=10 }
branch { L=50  diam=1.5 nseg=2}
apic connect branch[0](0), 0.2

bigDend { L=500   diam=6   nseg=10 }
for i = 0, basalalBranchNum-1 basalBranch[i] {
      L=50
      diam=1.5
      nseg=2
}
bigDend connect basalBranch[0](0), 0.2
bigDend connect basalBranch[1](0), 0.3



for i=0,dendNum-1  dend[i] {
      L=100
      nseg=10
      diam=2
   }
connect apic(0), soma(0)
connect bigDend(0), soma(1)
soma for i=0,dendNum-1 {
      connect dend[i](0), 0.5
   }



// Group the apartments.
objref all, somatic, bigBasal, apical, allBasal, allDend
proc subsets() { local i
    objref  all, somatic, basal, bigBasal, apical, allBasal, allDend
    somatic = new SectionList()
        soma somatic.append()
    bigBasal = new SectionList()
        bigDend bigBasal.append()
    allBasal = new SectionList()
        for i=0,5 dend[i] allBasal.append()       
    apical = new SectionList()
        apic apical.append()
    allDend = new SectionList()
        allBasal allDend.append()
        apical   allDend.append()
 
}


// load axon file.
load_file("./createAxon_venStim.hoc")
create_axon()


proc geom() {
}
proc geom_nseg() {
}
proc biophys() {
}


access soma

celldef()
