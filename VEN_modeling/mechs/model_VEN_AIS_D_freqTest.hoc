



// --------------------------------------------------
//    Parameter Settings
// --------------------------------------------------

/* Global */
  dt = 0.01
  celsius   = 26
  steps_per_ms = 1/dt
  tstop = 100
  v_init = -70
  
/* Others */
  delay = 2  // global delay for preparing
  axonOnSoma=1
  
/* Passive membrane */
  ra        = 150  // decrease ad to decrease of soma vth variability, increase axon's vth variability
  global_ra = ra
  rm        = 30000   // g_pas=1/rm
  c_m       = 0.5
  cm_myelin = 0.02
  g_pas_node = 0.02

/* Active channels */
  // Nav
  Ena = 60
  gna12_soma = 80
  gna12_dend = 80 
  gna12_ais_max = 3200   // Nav1.2 
  gna16_ais_max = 3200   // Nav1.6
  gna16_nakeaxon= 300    
  gna12_myelin=20       // Nav1.2 at myelins
  gna16_node = 3200     // Nav1.6 at node
  
  vhalf_na12 = -30
  vhalf_na16 = -43
  vhalf_na = -30
  
  // Kv
  Ek = -90  
  gkv_soma = 20
  gkv_dend = 10 
  gkv_axon = 1000
  
  // Km
  gkm = .3
  gkm_soma = gkm
  
  // Kca
  gkca = 3
  gkca_soma = gkca
  
  // Ca
  Eca=140
  gca = .3
  gca_soma = gca



// ------------------------------------------------
//    Cell Geometry
// ------------------------------------------------

/*------------load the morphology of VEN----------*/
load_file("../VEN/VEN_morph.hoc")

/*------------Insert density mechanisms-----------*/
load_file("densityMech.hoc")

/*--------------Insert Point Processes------------*/
// Install passive membrane properties
install_passive()  
// Install active channels
install_channels()



// ===============================================
//          initial the point process and run control           
// -----------------------------------------------

// PointProcess Group Manager
load_file("pointgrp.hoc")
makeppgm()

// RunControl
{
  xpanel("RunControl",0)
  v_init = -70
  xvalue("Init","v_init", 1,"stdinit()", 1, 1 )
  xbutton("Init & Run","run()")
  xbutton("Stop","stoprun=1")
  continueTil_t = 150
  xvalue("Continue til","continueTil_t", 1,"{continuerun(runStopAt) stoprun=1}", 1, 1 )
  continueFor_t = 100
  xvalue("Continue for","continueFor_t", 1,"{continuerun(t + runStopIn) stoprun=1}", 1, 1 )
  xbutton("Single Step","steprun()")
  t = 0
  xvalue("t","t", 2 )
  tstop = 1050
  xvalue("Tstop","tstop", 1,"tstop_changed()", 0, 1 )
  //dt = 0.01
  xvalue("dt", "dt", 1,"setdt()", 0, 1 )
  steps_per_ms = 100
  xvalue("Points plotted/ms","steps_per_ms", 1,"setdt()", 0, 1 )
  screen_update_invl = 0.05  
  xvalue("Scrn update invl","screen_update_invl", 1,"", 0, 1 )
  realtime = 0
  xvalue("Real Time","realtime", 0,"", 0, 1 )
  xpanel(70,200)
}


// ===============================================
//        create the AP visionalize windows             
// -----------------------------------------------


objectvar scene_vector_[3]
objref plot_shapePlotV
// ShapePlot of V
{
plot_shapePlotV = new PlotShape(0)
plot_shapePlotV.size(-1090.04,748.086,-206.227,1656.04)
plot_shapePlotV.variable("v")
scene_vector_[0] = plot_shapePlotV
{plot_shapePlotV.view(-1090.04, -206.227, 1838.12, 1862.27, 584, 48, 280.8, 285.4)}
fast_flush_list.append(plot_shapePlotV)
plot_shapePlotV.exec_menu("Shape Plot")
plot_shapePlotV.save_name("fast_flush_list.")
}
//objectvar scene_vector_[1]
//{doNotify()}




// Traces of V
objref plot_allTraceV
{
plot_allTraceV = new Graph(0)
plot_allTraceV.size(0,100,-90,60)
scene_vector_[1] = plot_allTraceV
{plot_allTraceV.view(0, -90, 1050, 150, 964, 411, 400.5, 300.7)}
graphList[0].append(plot_allTraceV)
plot_allTraceV.save_name("graphList[0].")
plot_allTraceV.addvar("soma.v( 0.5 )", 1, 3, 0.8, 0.9, 2)
plot_allTraceV.addvar("node[0].v( 0.5 )", 2, 1, 0.8, 0.9, 2)
}

// V along the Axon
objectvar rvp_, plot_rangeV
{
plot_rangeV = new Graph(0)
plot_rangeV.size(-111.633,511.033,-80,71.8167)
scene_vector_[2] = plot_rangeV
{plot_rangeV.view(-111.633, -80, 622.667, 140.833, 693, 504, 601.2, 200.8)}
flush_list.append(plot_rangeV)
plot_rangeV.save_name("flush_list.")
objectvar rvp_
rvp_ = new RangeVarPlot("v")
bigDend[26] rvp_.begin(1)
node[1] rvp_.end(1)
soma rvp_.origin(-30)   // set soma(0) as -30 so that the origin of rvp_ is located at soma(1). ONLINE HELP IS WRONG!!
plot_rangeV.addobject(rvp_, 2, 1, 0.8, 0.9)

// labels
plot_rangeV.label(0.207373, 0.706937, "soma", 2, 1, 0, 0, 1)
plot_rangeV.label(0.208084, 0.6499, ">|-|<", 2, 1, 0, 0, 1)
//plot_rangeV.label(0.0973049, 0.618525, "dend11[22]", 2, 1, 0, 0, 3)
plot_rangeV.label(0.0553888, 0.560259, "|----------------------------------|", 2, 1, 0, 0, 3)
plot_rangeV.label(0.26036, 0.600564, "ais", 2, 1, 0, 0, 2)
plot_rangeV.label(0.238543, 0.554973, "|---------------|", 2, 1, 0, 0, 2)
plot_rangeV.label(0.841318, 0.62749, "myelin[0]", 2, 1, 0, 0, 5)
plot_rangeV.label(0.853294, 0.555777, "|-------|", 2, 1, 0, 0, 5)
plot_rangeV.label(0.495509, 0.60508, "Unmyelinated Axon", 2, 1, 0, 0, 9)
plot_rangeV.label(0.311377, 0.555777, "|------------------------------------------------------------------------------------------------------------------------|", 2, 1, 0, 0, 9)
}                 







// -----------------------------------------------
//          recording saving trace data           
// -----------------------------------------------

/* --------record soma data into a variable ---------*/  
objref rec_somaTrace
rec_somaTrace = new Vector()
rec_somaTrace.record(&soma.v(0.5),0.01)   // 0.01: set for sample frequency, point interval = 0.01 ms (100 points within each 1 ms)
/* --------------- save soma data -------------------*/
objref f, dataMat
proc saveTrace_soma() {
  dataMat = new Matrix()      // set a matrix for data dumping
  dataMat.resize(rec_somaTrace.size(),1)
  dataMat.setcol(0,rec_somaTrace)

  f = new File()             // create a file and save data.
  f.wopen("savedData_VENL_soma.dat")
  dataMat.fprint(f,"%g")
  f.close()
}


/* --------record axon data into a variable ---------*/  
objref rec_axonTrace
rec_axonTrace = new Vector()
rec_axonTrace.record(&node[0].v(0.5),0.01)   // 0.01: set for sample frequency, point interval = 0.01 ms (100 points within each 1 ms)

/* --------------- save axon data -------------------*/
objref f, dataMat
proc saveTrace_axon() {
  dataMat = new Matrix()      // set a matrix for data dumping
  dataMat.resize(rec_axonTrace.size(),1)
  dataMat.setcol(0,rec_axonTrace)

  f = new File()             // create a file and save data.
  f.wopen("savedData_VENL_axon.dat")
  dataMat.fprint(f,"%g")
  f.close()
}

// create a save button to control sata saving.
xpanel("Save tace data to traceData.dat ")
{
  xbutton("Save Trace data (soma)","saveTrace_soma()")
  xbutton("Save Trace data (axon)","saveTrace_axon()")
  xpanel(1000,300)
}











inputFreq = 500     // per second;  1000 per sec = 1 per ms  
testT = 1000           // ms
// calculate the number of synapses.
nInput = testT*inputFreq/1000
inputInterval = 1000/inputFreq

objref RandomVec
highindex = 1
RandomVec = new Vector(nInput)
for i = 0,RandomVec.size-1 {
   RandomVec.x[i] = mcell_ran4(&highindex)
}
//topRange_Of_RandomE = -20     // means the range of AlphaSynapse.E is [-70,-20].

objref AlphaSyn1[nInput], AlphaSyn2[nInput]
//for i = 0,nInput-1 {
//     //   apic[1] AlphaSyn1[i] = new AlphaSynapse(1)
//      apic[3] AlphaSyn1[i] = new AlphaSynapse(0.5)
//     //   soma AlphaSyn1[i] = new AlphaSynapse(0.5)
//   AlphaSyn1[i].onset = 20+ i* inputInterval
//   AlphaSyn1[i].tau = 0.1
//   AlphaSyn1[i].gmax = 0.07   // AlphaSyn1[i].e = 10+(topRange_Of_RandomE+70) * RandomVec.x[i]
//   AlphaSyn1[i].e = -70+60*RandomVec.x[i]
//}
for i = 0,nInput-1 {
     // bigDend[5] AlphaSyn2[i] = new AlphaSynapse(0.5)
      bigDend[3] AlphaSyn2[i] = new AlphaSynapse(1)
      //   soma AlphaSyn2[i] = new AlphaSynapse(0.5)
   AlphaSyn2[i].onset = 20+ (i)* inputInterval         // define the phase difference: -pi (-0.5), -5*pi/6 (-5/12),-2*pi/3 (-1/3),-pi/2 (-1/4),-pi/3 ()-1/6,-pi/6 (-1/12),0,pi/6 (1/12),pi/3 (1/6),pi/2 (1/4),2*pi/3 (1/3),5*pi/6 ()5/12, pi (0.5).  See result file : data_varySynapticPhase.txt
   AlphaSyn2[i].tau = 0.1
   AlphaSyn2[i].gmax = 0.07
   // AlphaSyn2[i].e = 10+(topRange_Of_RandomE+70) * RandomVec.x[i]
   AlphaSyn2[i].e = -70+60*RandomVec.x[i]
}







